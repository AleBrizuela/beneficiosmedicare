# Cloudflare Pages custom headers
# Prevent aggressive caching of HTML files so deployments take effect immediately

/widget-v4.html
  Cache-Control: no-cache, must-revalidate
  X-Widget-Version: v4.3-exp

/*.html
  Cache-Control: public, max-age=300

/data/*
  Cache-Control: public, max-age=86400

/experiments/*
  Cache-Control: no-cache, must-revalidate

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap-style.xsl
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# T-039: social post images, fetched by the Claude browser from Facebook/Instagram/GBP/LinkedIn.
# Not linked, not in the sitemap, not indexed.
/social/*
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600
