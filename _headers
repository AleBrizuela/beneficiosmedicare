# Cloudflare Pages custom headers
# Prevent aggressive caching of HTML files so deployments take effect immediately

/widget-v4.html
  Cache-Control: no-cache, must-revalidate
  X-Widget-Version: v4.3-exp

/*.html
  Cache-Control: public, max-age=300

/data/*
  Cache-Control: public, max-age=86400
  X-Robots-Tag: noindex

/experiments/*
  Cache-Control: no-cache, must-revalidate
  X-Robots-Tag: noindex

# T-147 (AB 2026-10-25): Google indexed /partials/footer-en as "Untitled" -- the footer/header
# source fragments live here, publicly served, with no <title>. stamp-shared.mjs copies their
# content INTO every real page at commit time; no live page ever fetches these at request time
# (verified: no fetch()/XHR reference to partials/ anywhere in the repo), so a 301 here would cost
# nothing functionally -- but the ticket asks for noindex specifically (not a block), so Google
# can still reach and re-crawl the real pages that quote this content, it just won't list the
# fragment itself as its own result. robots.txt is deliberately NOT touched.
/partials/*
  X-Robots-Tag: noindex

/widget*.html
  X-Robots-Tag: noindex

/presentacion*
  X-Robots-Tag: noindex

/presentation*
  X-Robots-Tag: noindex

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap-style.xsl
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# T-039: social post images, fetched by the Claude browser from Facebook/Instagram/GBP/LinkedIn.
# Not linked, not in the sitemap, not indexed.
/social/*
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600
